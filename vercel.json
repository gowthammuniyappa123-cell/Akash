{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/blob.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/blob",
      "dest": "/api/blob.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}